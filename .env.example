# .env.example -- template for docker-compose.yml in this repo's root.
# Copy to .env (gitignored, never committed) and fill in real values.
# On the deploy VM, the deploy workflow writes the real .env here from GitHub Secrets at deploy
# time -- never bake real values into docker-compose.yml itself.

# ─── Required -- no fallback default in docker-compose.yml, matching this project's own
# ─── application.yml convention (SPRING_DATASOURCE_PASSWORD / JWT_SECRET are required env vars
# ─── there too, with no insecure default). Leaving these unset means MySQL/JWT/AI auth will
# ─── genuinely fail loudly rather than silently run on a known, guessable value.
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=
JWT_SECRET=
AI_SECRET_KEY=

# ─── Non-secret, sensible defaults already baked into docker-compose.yml -- override only if
# ─── you need something other than the default.
# DB_NAME=slt_fieldops_db
# DB_USER=sltuser
# JWT_ACCESS_EXPIRY_MINUTES=30
# JWT_REFRESH_EXPIRY_DAYS=7
# FIREBASE_ENABLED=false
# SPRING_PROFILES=docker
# SPRING_LOG_LEVEL=INFO
# FLASK_ENV=production
# FLASK_DEBUG=false
# AI_LOG_LEVEL=INFO
