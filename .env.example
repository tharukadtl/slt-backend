# ─── docker-compose.yml environment template ──────────────────────────────
# Copy to .env (already gitignored -- confirmed, see .gitignore) and fill in real
# values. Never commit the real .env; this file carries no real secrets, only
# variable names and non-sensitive defaults.

# ── MySQL ───────────────────────────────────────────────────────────────────
DB_NAME=slt_fieldops_db
DB_USER=sltuser
DB_PASSWORD=change-this-password
MYSQL_ROOT_PASSWORD=change-this-root-password

# ── fieldops (Spring Boot) ──────────────────────────────────────────────────
# 256-bit+ random value in a real deployment -- application.yml deliberately has
# no fallback default for this one (see its own comment), so a container that
# doesn't get this set will fail to start rather than silently sign tokens with a
# guessable secret.
JWT_SECRET=change-this-to-a-real-256-bit-secret

# ── AI module (Flask) ───────────────────────────────────────────────────────
AI_SECRET_KEY=change-this-flask-secret-key

# ── frontend-admin (baked into the build at image-build time, not read at
#    container runtime -- see Dockerfile's own comment on why) ──────────────
REACT_APP_API_URL=http://localhost:8080/api
REACT_APP_AI_URL=http://localhost:5000
